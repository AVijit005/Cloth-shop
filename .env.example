# Database Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=shibani_store

# Custom Env Backwards Compatibility
SHIBANI_DB_HOST=127.0.0.1
SHIBANI_DB_PORT=3306
SHIBANI_DB_USER=root
SHIBANI_DB_PASSWORD=your_password_here
SHIBANI_DB_NAME=shibani_store
SHIBANI_ENV=development
SHIBANI_SECRET_KEY=change_me_to_a_random_secret

# Application Security
SECRET_KEY=change_me_to_a_random_secret
FLASK_ENV=development

# SMTP (optional for password reset / verification emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your_app_password
# SMTP_SENDER=noreply@shibanifashion.com
